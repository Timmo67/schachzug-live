    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "stockfish": "18.0.8",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.20.5",
